assets/Collapse/*.jpg
assets/Collapse/*.webp
# ExtraOrdinary original (site uses extraordinary-web.mp4)
assets/ExtraOrdinary/ExtraOrdinary_web.mp4
# MOPs: old background video, no longer referenced
assets/MOPS/osc3.0.mp4

